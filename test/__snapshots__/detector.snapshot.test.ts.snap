exports[`CloudFormationStackDriftDetector snapshots matches failure detection: failure detection 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "AlarmTopicD01E77F9": {
      "Type": "AWS::SNS::Topic",
    },
    "DetectorFailureDetectionDriftDetectionFailedAlarm5D1907F6": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicD01E77F9",
          },
        ],
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "DriftDetectionFailed",
        "Namespace": "CloudFormationStackDriftDetector",
        "Period": 300,
        "Statistic": "Sum",
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "DetectorFailureDetectionDriftDetectionFailedMetric06E6FD1F": {
      "Properties": {
        "FilterPattern": ""DriftDetectionFailed"",
        "LogGroupName": {
          "Ref": "DetectorLogGroup7F84711E",
        },
        "MetricTransformations": [
          {
            "DefaultValue": 0,
            "MetricName": "DriftDetectionFailed",
            "MetricNamespace": "CloudFormationStackDriftDetector",
            "MetricValue": "1",
          },
        ],
      },
      "Type": "AWS::Logs::MetricFilter",
